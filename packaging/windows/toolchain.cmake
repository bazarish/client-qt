# Bazarish project (c) 2026
# Read from the environment: CMake's own test compiles see it, not the cache.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR $ENV{BAZARISH_WIN_ARCH})

set(kTriple $ENV{BAZARISH_WIN_ARCH}-w64-mingw32)
set(CMAKE_C_COMPILER $ENV{BAZARISH_LLVM_MINGW}/bin/${kTriple}-clang)
set(CMAKE_CXX_COMPILER $ENV{BAZARISH_LLVM_MINGW}/bin/${kTriple}-clang++)
set(CMAKE_RC_COMPILER $ENV{BAZARISH_LLVM_MINGW}/bin/${kTriple}-windres)
set(CMAKE_AR $ENV{BAZARISH_LLVM_MINGW}/bin/llvm-ar)
set(CMAKE_RANLIB $ENV{BAZARISH_LLVM_MINGW}/bin/llvm-ranlib)

set(CMAKE_FIND_ROOT_PATH $ENV{BAZARISH_WIN_SYSROOT})
set(CMAKE_PREFIX_PATH $ENV{BAZARISH_WIN_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(QT_HOST_PATH $ENV{BAZARISH_QT_HOST})
